# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Run records stay local; only allowlisted exports go under docs/benchmark/
runs/
*.log

# Secrets and private data never go into this repo. customize/ holds the owner's own tasks
# (accounts, messages, mail) and stays on this machine.
customize/
.env
.envrc.local
*.key
private/
snapshots/

# Never commit weights or checkpoints
*.safetensors
*.gguf
models/

.DS_Store

# Local preview mirror and review screenshots; canonical website source is in site/.
/website-demo/

# The memory suite's own localmelo clone (eval/memory/vendor/localmelo, pinned in eval/memory/README.md)
eval/memory/vendor/

# E3 gets its own pinned localmelo clone (eval/agent_ability/README.md, section E3)
eval/agent_ability/e3/vendor/
