   "id": "m7-17-long-string",
   "category": "long string args",
   "messages": [
    {
     "role": "user",
     "content": "Write the following text to docs/notice.md exactly as given, as a single paragraph:\n\n```\nScheduled maintenance: on Saturday, 2026-11-07, between 06:00 and 08:00 UTC, the demo-app staging environment will be unavailable while the database is migrated to the new storage layout. Jobs that are queued during the window will start after the migration completes, in their original order. The public API keeps its current version, and no client changes are required. If a job fails after the migration, rerun it once; if it fails again, attach the job id and the last fifty lines of the job log to the release issue so that the maintainers can investigate. The next maintenance window is planned for early December and will be announced at least one week in advance.\n```"
    }
   ],
   "expect": {
    "calls": [
     {
      "name": "fs_write_file",
      "args": {
       "path": {
        "eq": "docs/notice.md",
        "norm": "path"
       },
       "content": {
        "eq": "Scheduled maintenance: on Saturday, 2026-11-07, between 06:00 and 08:00 UTC, the demo-app staging environment will be unavailable while the database is migrated to the new storage layout. Jobs that are queued during the window will start after the migration completes, in their original order. The public API keeps its current version, and no client changes are required. If a job fails after the migration, rerun it once; if it fails again, attach the job id and the last fifty lines of the job log to the release issue so that the maintainers can investigate. The next maintenance window is planned for early December and will be announced at least one week in advance.",
        "norm": "strip"
       }
      }
     }
    ]
   },
   "reference": [
    {
     "name": "fs_write_file",
     "arguments": {
      "path": "docs/notice.md",
      "content": "Scheduled maintenance: on Saturday, 2026-11-07, between 06:00 and 08:00 UTC, the demo-app staging environment will be unavailable while the database is migrated to the new storage layout. Jobs that are queued during the window will start after the migration completes, in their original order. The public API keeps its current version, and no client changes are required. If a job fails after the migration, rerun it once; if it fails again, attach the job id and the last fifty lines of the job log to the release issue so that the maintainers can investigate. The next maintenance window is planned for early December and will be announced at least one week in advance.\n"
     }
    }
   ]
