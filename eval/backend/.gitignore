# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime state and local logs (server logs carry absolute local paths)
logs/
*.log

# Disturbed units, mechanics checks and exploratory runs never go public
results/_unverified/

# Never commit weights or checkpoints
*.safetensors
*.gguf
models/

# Generated fixtures (rebuild with `uv run modeleval fixtures`)
fixtures/generated/

# Secrets
.env
*.key

# This machine's overrides of config.defaults.toml
config.toml

.DS_Store
runs/
vendor/
envs/*/.venv/
